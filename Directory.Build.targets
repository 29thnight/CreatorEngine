<?xml version="1.0" encoding="utf-8"?>
<!--
  EngineAsan=true 일 때만 AddressSanitizer 옵션을 건다(PHASE 9-0 / 0-5).

  이 파일은 프로젝트 내용보다 **뒤에** 임포트되므로 여기의 ItemDefinitionGroup이
  각 vcxproj의 설정을 이긴다. props가 아니라 targets에 두는 이유가 그것이다.

  ── ASan이 켜질 때 함께 꺼야 하는 것들 ──

  · /RTC1  : ASan과 동시에 못 쓴다(컴파일러가 거부한다).
  · /ZI    : 편집하며 계속하기 형식의 디버그 정보를 지원하지 않는다. /Zi로 내린다.
  · 증분 링크: 지원하지 않는다.
  · /GL    : 전체 프로그램 최적화와 함께 쓸 수 없다.
  · 유니티 빌드: 여러 .cpp가 한 번역 단위로 합쳐지면 ASan 보고서의 파일·행이
    합본 파일을 가리켜 원인 파일을 짚을 수 없다. 진단이 목적인 빌드라 끈다.

  ── 컨테이너 주석(annotation)을 끄는 이유 ──

  MSVC의 std::vector/std::string은 ASan용 경계 주석을 심는데, 이 주석은 프로그램
  전체가 같은 설정으로 빌드되어야 성립한다. 이 저장소는 vcpkg의 미리 빌드된 정적
  라이브러리를 여럿 링크하므로(주석 없음) 섞이는 순간 container-overflow 거짓 양성이
  쏟아진다. 거짓 양성이 섞인 보고서는 아무도 읽지 않게 되므로 아예 끈다.

  ── ASan 런타임 DLL ──

  /MD 계열은 clang_rt.asan_dynamic-x86_64.dll 을 실행 시점에 찾는다.
  없으면 프로세스가 기동하지 못한다. VS 도구 폴더에 있으므로 개발자 명령 프롬프트에서
  실행하거나 exe 옆에 복사한다:
    %VCToolsInstallDir%bin\Hostx64\x64\clang_rt.asan_dynamic-x86_64.dll

  ── 권장 ASAN_OPTIONS ──

    set ASAN_OPTIONS=detect_leaks=0:halt_on_error=1:abort_on_error=1:print_stats=1
  누수 검출은 Windows에서 지원되지 않으므로 끄고, 첫 오류에서 즉시 멈춘다
  (계속 돌리면 첫 오류가 만든 오염이 뒤의 보고서를 전부 못 믿게 만든다).
-->
<Project>

  <!--
    Mathematics는 헤더 온리 고정 의존이다. 프로젝트보다 먼저 읽히는 props에
    두면 vcxproj의 구성별 AdditionalIncludeDirectories가 값을 덮을 수 있다.
    프로젝트 뒤에 읽히는 여기서 기존 목록 앞에 붙여 모든 native 구성이 같은
    vendored 판본을 실제로 보게 한다.
  -->
  <ItemDefinitionGroup Condition="'$(MSBuildProjectExtension)' == '.vcxproj'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(SolutionDir)ThirdParty\Mathematics\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- Windows.h의 함수형 min/max 매크로가 Mathematics의 min/max API를
           include 순서에 따라 치환하지 못하게 native 빌드 전체에서 차단한다. -->
      <PreprocessorDefinitions>NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <PropertyGroup Condition="'$(EngineAsan)' == 'true' and '$(MSBuildProjectExtension)' == '.vcxproj'">
    <LinkIncremental>false</LinkIncremental>
    <WholeProgramOptimization>false</WholeProgramOptimization>
    <!-- VS의 유니티(점보) 빌드. 이 저장소는 Academy_4Q가 켜 두고 있다. -->
    <EnableUnitySupport>false</EnableUnitySupport>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(EngineAsan)' == 'true' and '$(MSBuildProjectExtension)' == '.vcxproj'">
    <ClCompile>
      <EnableASAN>true</EnableASAN>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <WholeProgramOptimization>false</WholeProgramOptimization>
      <!--
        ENGINE_ASAN: 엔진 할당을 mimalloc에서 CRT로 되돌리는 스위치.
        MemoryManager.cpp가 이 매크로를 본다. 자세한 이유는 그 파일 주석에 있다 —
        이것을 켜지 않으면 ASan이 GameObject·Component 할당을 아예 보지 못해
        이 빌드 구성의 목적 자체가 사라진다.
      -->
      <PreprocessorDefinitions>ENGINE_ASAN;_DISABLE_VECTOR_ANNOTATION;_DISABLE_STRING_ANNOTATION;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <LinkTimeCodeGeneration>Default</LinkTimeCodeGeneration>
    </Link>
  </ItemDefinitionGroup>

  <!--
    StaticLibrary의 MSVC 기본 /Fd는 $(OutDir)$(TargetName).pdb라 컴파일 PDB/IDB가
    Build\Lib에 섞인다. 컴파일 데이터는 중간물이므로 프로젝트별 IntDir에 둔다.
    실행 파일의 최종 linker PDB는 각 앱 OutDir에 그대로 남는다.
  -->
  <ItemDefinitionGroup Condition="'$(MSBuildProjectExtension)' == '.vcxproj'">
    <ClCompile>
      <ProgramDataBaseFileName>$(IntDir)$(MSBuildProjectName).pdb</ProgramDataBaseFileName>
    </ClCompile>
  </ItemDefinitionGroup>

  <!--
    Editor와 Player는 각자 독립 실행 번들이다. 암시적으로 import되는 DLL은 main
    진입 전에 Windows 로더가 찾으므로 EXE 옆에 배치한다. vcpkg AppLocal 배치는
    포트 의존성을 담당하고, 저장소/SDK 소유 런타임만 여기서 명시적으로 닫는다.
  -->
  <Target Name="DeployEngineHostRuntime"
          AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'CreatorEditor' or '$(MSBuildProjectName)' == 'Player'">
    <PropertyGroup>
      <_EngineFmodRuntime Condition="'$(Configuration)' == 'Debug'">$(SolutionDir)ThirdParty\Fmod\bin\x64\fmodL.dll</_EngineFmodRuntime>
      <_EngineFmodRuntime Condition="'$(Configuration)' != 'Debug'">$(SolutionDir)ThirdParty\Fmod\bin\x64\fmod.dll</_EngineFmodRuntime>
      <_EnginePhysXGpuRuntime Condition="'$(Configuration)' == 'Debug'">$(_ZVcpkgCurrentInstalledDir)debug\bin\PhysXGpu_64.dll</_EnginePhysXGpuRuntime>
      <_EnginePhysXGpuRuntime Condition="'$(Configuration)' != 'Debug'">$(_ZVcpkgCurrentInstalledDir)bin\PhysXGpu_64.dll</_EnginePhysXGpuRuntime>
      <_EnginePhysXDeviceRuntime Condition="'$(Configuration)' == 'Debug'">$(_ZVcpkgCurrentInstalledDir)debug\bin\PhysXDevice64.dll</_EnginePhysXDeviceRuntime>
      <_EnginePhysXDeviceRuntime Condition="'$(Configuration)' != 'Debug'">$(_ZVcpkgCurrentInstalledDir)bin\PhysXDevice64.dll</_EnginePhysXDeviceRuntime>
    </PropertyGroup>
    <ItemGroup>
      <_EngineHostRuntime Include="$(DotNetHostPackDir)nethost.dll" />
      <_EngineHostRuntime Include="$(_EngineFmodRuntime)" />
      <_EngineHostRuntime Include="$(SolutionDir)ThirdParty\Slang\bin\slang-compiler.dll" />
      <_EngineHostRuntime Include="$(SolutionDir)ThirdParty\Slang\bin\dxcompiler.dll" />
      <_EngineHostRuntime Include="$(SolutionDir)ThirdParty\Slang\bin\dxil.dll" />
      <_EngineHostRuntime Include="$(_EnginePhysXGpuRuntime)" />
      <_EngineHostRuntime Include="$(_EnginePhysXDeviceRuntime)" />
    </ItemGroup>
    <Error Condition="!Exists('%(_EngineHostRuntime.Identity)')"
           Text="Required host runtime is missing: %(_EngineHostRuntime.Identity)" />
    <Copy SourceFiles="@(_EngineHostRuntime)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
    <Message Text="Host runtime 배치: $(MSBuildProjectName) -> $(OutDir)" Importance="high" />
  </Target>

  <!-- Editor 전용 아이콘과 구 DX 셰이더 산출물도 실행 파일과 분리한다. -->
  <Target Name="DeployEditorResources"
          AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'CreatorEditor'">
    <PropertyGroup>
      <_EngineLegacyShaderRoot Condition="'$(Configuration)' == 'Debug'">$(SolutionDir)x64\Assets\Shaders\</_EngineLegacyShaderRoot>
      <_EngineLegacyShaderRoot Condition="'$(Configuration)' != 'Debug'">$(SolutionDir)Bin\Assets\Shaders\</_EngineLegacyShaderRoot>
    </PropertyGroup>
    <ItemGroup>
      <_EngineIconResource Include="$(SolutionDir)x64\Icons\**\*" />
      <_EngineShaderResource Include="$(_EngineLegacyShaderRoot)**\*"
                             Condition="Exists('$(_EngineLegacyShaderRoot)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_EngineIconResource)"
          DestinationFolder="$(EngineResourceOutDir)Icons\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_EngineShaderResource)"
          DestinationFolder="$(EngineResourceOutDir)Shaders\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_EngineShaderResource)' != ''" />
    <Message Text="Editor resources 배치 -> $(EngineResourceOutDir)" Importance="high" />
  </Target>

</Project>
