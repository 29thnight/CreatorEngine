<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CreatorEngine.AudioValues</AssemblyName>
    <FSharpCoreImplicitPackageVersion>10.0.112</FSharpCoreImplicitPackageVersion>
    <NoInterfaceData>true</NoInterfaceData>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>
  <ItemGroup><Compile Include="AudioValues.fs" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../../../Tools/build/ScriptValueCtorFixup/ScriptValueCtorFixup.csproj" ReferenceOutputAssembly="false" Private="false" PrivateAssets="all" /></ItemGroup>
  <Target Name="FixAudioValueConstructor" AfterTargets="CoreCompile" BeforeTargets="CopyFilesToOutputDirectory" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet &quot;$(MSBuildProjectDirectory)/../../../Tools/build/ScriptValueCtorFixup/bin/$(Configuration)/net10.0/ScriptValueCtorFixup.dll&quot; &quot;$(IntermediateOutputPath)$(TargetFileName)&quot;" />
  </Target>
</Project>
