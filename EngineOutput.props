<?xml version="1.0" encoding="utf-8"?>
<!--
  실행 가능한 산출물의 디렉터리 계약을 한 곳에서 정한다.

    Bin\<플랫폼>-<구성>\Editor\              CreatorEditor 실행 번들
    Bin\<플랫폼>-<구성>\Player\              Player 실행 번들
    Bin\<플랫폼>-<구성>\Tools\<도구 이름>\    AssetCooker/AssetPacker 실행 번들
    Bin\<플랫폼>-<구성>\Managed\             공통 관리 어셈블리
    Bin\<플랫폼>-<구성>\Resources\           엔진 리소스

  EXE와 암시적으로 로드되는 네이티브 DLL은 Windows 로더 계약상 각 실행 번들
  안에 함께 둔다. 캐시·로그·덤프·테스트 결과는 이 트리에 두지 않는다.

  ── nethost.dll ──

  hostfxr를 찾아 주는 얇은 DLL이다. 이것이 없으면 스크립트 계층이 통째로
  죽는데, 그동안 저장소에 없는 파일이 x64\Debug\에 손으로 놓여 있었다.
  즉 새로 받은 사람은 Debug조차 스크립트 없이 돌았고, 아무도 그것을 알리는
  장치가 없었다. 빌드가 직접 배치하게 한다.

  헤더·링크·DLL 배치가 모두 이 속성을 참조한다. 버전을 여러 파일에 직접
  박아 두면 한쪽만 갱신되어 링크 또는 실행 단계에서 뒤늦게 실패한다.
-->
<Project>
  <PropertyGroup>
    <!-- dotnet build의 기본 Platform은 AnyCPU다. 관리 어셈블리는 x64 Host 전용이다. -->
    <EnginePlatform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</EnginePlatform>
    <EnginePlatform Condition="'$(EnginePlatform)' == ''">$(Platform)</EnginePlatform>
    <EngineBuildKey>$(EnginePlatform)-$(Configuration)</EngineBuildKey>
    <EngineBinaryRoot>$(MSBuildThisFileDirectory)Bin\$(EngineBuildKey)\</EngineBinaryRoot>
    <EngineEditorOutDir>$(EngineBinaryRoot)Editor\</EngineEditorOutDir>
    <EnginePlayerOutDir>$(EngineBinaryRoot)Player\</EnginePlayerOutDir>
    <EngineToolOutDir>$(EngineBinaryRoot)Tools\$(MSBuildProjectName)\</EngineToolOutDir>
    <EngineManagedOutDir>$(EngineBinaryRoot)Managed\</EngineManagedOutDir>
    <EngineResourceOutDir>$(EngineBinaryRoot)Resources\</EngineResourceOutDir>

    <!-- 구 소비자가 이 값을 읽어도 더는 Editor/Player/Tool을 한 폴더에 합치지 않는다. -->
    <EngineOutDir>$(EngineBinaryRoot)</EngineOutDir>

    <DotNetHostPackVersion>10.0.11</DotNetHostPackVersion>
    <DotNetHostPackDir>C:\Program Files\dotnet\packs\Microsoft.NETCore.App.Host.win-x64\$(DotNetHostPackVersion)\runtimes\win-x64\native\</DotNetHostPackDir>
  </PropertyGroup>
</Project>
