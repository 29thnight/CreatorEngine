schema: 1
name: ShaderMetaFixture
source: ShaderMetaFixture.hlsl
properties:
  - { name: tint, label: Tint, type: float4, default: [1.0, 0.5, 0.25, 1.0] }
  - { name: roughness, label: Roughness, type: float, default: 0.5 }
  - { name: albedoMap, label: Albedo Map, type: texture2d }
keywords:
  - { axis: QUALITY, values: [low, high] }
passes:
  - name: Forward
    vs: { entry: VSMain }
    ps: { entry: PSMain }
    state:
      fill: solid
      cull: back
      blend: alpha
      depthWrite: false
      depthTest: lessEqual
      topology: triangle
    queue: transparent
