schema: 1
name: EnhancedForwardWater
source: ForwardWater.hlsl
properties:
  - { name: baseColor, label: Base Color, type: float4, default: [0.08, 0.32, 0.55, 0.65] }
  - { name: metallic, label: Metallic, type: float, default: 0.0 }
  - { name: roughness, label: Roughness, type: float, default: 0.15 }
  - { name: normalScale, label: Normal Scale, type: float, default: 1.0 }
  - { name: occlusionStrength, label: Occlusion Strength, type: float, default: 1.0 }
  - { name: emissive, label: Emissive, type: float3, default: [0.05, 0.15, 0.30] }
  - { name: alphaCutoff, label: Alpha Cutoff, type: float, default: 0.5 }
  - { name: waveSpeed, label: Wave Speed, type: float, default: 0.35 }
  - { name: waveAmplitude, label: Wave Amplitude, type: float, default: 0.08 }
  - { name: waveFrequency, label: Wave Frequency, type: float, default: 2.0 }
  - { name: waterTint, label: Water Tint, type: float, default: 0.8 }
  - { name: baseColorMap, label: Base Color Map, type: texture2d }
  - { name: normalMap, label: Normal Map, type: texture2d }
  - { name: ormMap, label: ORM Map, type: texture2d }
  - { name: emissiveMap, label: Emissive Map, type: texture2d }
keywords:
  - { axis: SHADING_QUALITY, values: [full, reduced] }
passes:
  - name: Forward
    vs: { entry: VSMain }
    ps: { entry: PSMain }
    state:
      fill: solid
      cull: back
      blend: alpha
      depthWrite: false
      depthTest: less
      topology: triangle
    queue: transparent
