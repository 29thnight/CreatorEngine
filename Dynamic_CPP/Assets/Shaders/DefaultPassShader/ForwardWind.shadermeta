schema: 1
name: EnhancedForwardWind
source: ForwardWind.hlsl
properties:
  - { name: baseColor, label: Base Color, type: float4, default: [0.30, 0.75, 0.25, 0.45] }
  - { name: metallic, label: Metallic, type: float, default: 0.0 }
  - { name: roughness, label: Roughness, type: float, default: 0.45 }
  - { name: normalScale, label: Normal Scale, type: float, default: 1.0 }
  - { name: occlusionStrength, label: Occlusion Strength, type: float, default: 1.0 }
  - { name: emissive, label: Emissive, type: float3, default: [0.04, 0.20, 0.03] }
  - { name: alphaCutoff, label: Alpha Cutoff, type: float, default: 0.5 }
  - { name: windSpeed, label: Wind Speed, type: float, default: 1.2 }
  - { name: windStrength, label: Wind Strength, type: float, default: 0.35 }
  - { name: windFrequency, label: Wind Frequency, type: float, default: 2.5 }
  - { name: windTint, label: Wind Tint, type: float, default: 0.7 }
  - { name: flowUvScroll, label: Flow UV Scroll, type: float2, default: [0.0, 0.0] }
  - { name: flowWindVector, label: Flow Wind Vector, type: float4, default: [0.0, 0.0, 0.0, 0.0] }
  - { name: windMap, label: Wind Map, type: texture2d }
  - { name: normalMap, label: Normal Map, type: texture2d }
  - { name: ormMap, label: ORM Map, type: texture2d }
  - { name: emissiveMap, label: Emissive Map, type: texture2d }
keywords:
  - { axis: SHADING_QUALITY, values: [full, reduced] }
passes:
  - name: Forward
    vs: { entry: VSMain }
    ps: { entry: PSMain }
    state:
      fill: solid
      cull: back
      blend: alpha
      depthWrite: false
      depthTest: less
      topology: triangle
    queue: transparent
