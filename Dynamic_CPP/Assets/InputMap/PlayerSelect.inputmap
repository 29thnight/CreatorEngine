schemaVersion: 1
mapName: "PlayerSelect"
actions:
  - actionName: "PlayerSelectUIMove"
    inputType: "GamePad"
    actionType: "Value"
    keyState: "Down"
    keys: [12, 0, 0, 0]
    scriptName: "InputDeviceDetector"
    functionName: "MoveSelector"
  - actionName: "PlayerSelectCharPress"
    inputType: "GamePad"
    actionType: "Button"
    keyState: "Pressed"
    keys: [0, 0, 0, 0]
    scriptName: "InputDeviceDetector"
    functionName: "CharSelect"
  - actionName: "PlayerSelectCharReleased"
    inputType: "GamePad"
    actionType: "Button"
    keyState: "Released"
    keys: [0, 0, 0, 0]
    scriptName: "InputDeviceDetector"
    functionName: "ReleaseKey"
  - actionName: "PlayerSelectScreenLeave"
    inputType: "GamePad"
    actionType: "Button"
    keyState: "Down"
    keys: [1, 0, 0, 0]
    scriptName: "InputDeviceDetector"
    functionName: "LeaveSelectScene"
