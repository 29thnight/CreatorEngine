<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../EngineOutput.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CreatorEngine.NativeBindings</AssemblyName>
    <FSharpCoreImplicitPackageVersion>10.0.112</FSharpCoreImplicitPackageVersion>
    <OutputPath>$(EngineManagedOutDir)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ScriptNativeOutput>$(MSBuildProjectDirectory)/obj/$(Configuration)/native-bindings</ScriptNativeOutput>
    <ScriptNativeGenerator Condition="'$(ScriptNativeGenerator)' == ''">$(MSBuildProjectDirectory)/../vcpkg_installed/x64-windows/x64-windows/tools/reflgen/reflgen.exe</ScriptNativeGenerator>
    <ScriptNativeHeader>$(MSBuildProjectDirectory)/../Engine/SceneRuntime/ScriptApiTable.h</ScriptNativeHeader>
    <ScriptNativeClangArguments Condition="'$(ScriptNativeClangArguments)' == ''">-std=c++20 -target x86_64-pc-windows-msvc</ScriptNativeClangArguments>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ScriptNative.AudioValues/ScriptNative.AudioValues.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <_ScriptNativeInput Include="$(ScriptNativeHeader);$(MSBuildProjectDirectory)/../Engine/SceneRuntime/ScriptBindingValues.h;$(MSBuildProjectDirectory)/../Engine/SceneRuntime/ScriptPhysicsValues.h;$(MSBuildProjectDirectory)/../Engine/SceneRuntime/SimulationExchangeABI.h;$(MSBuildProjectDirectory)/../Engine/Utility_Framework/Runtime/ScriptApiVersion.h;$(ScriptNativeGenerator);$(ScriptNativeOutput)/generator-options.txt" />
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="$(ScriptNativeOutput)/reflgen_creator_script_native.fs" />
    <Compile Include="FastNativeCalls.fs" />
    <Compile Include="NativeBootstrap.fs" />
    <Compile Include="NativeLog.fs" />
    <Compile Include="Debug.fs" />
    <Compile Include="Profiler.fs" />
    <Compile Include="Values.fs" />
    <Compile Include="NativeReflection.fs" />
    <Compile Include="KeyCode.fs" />
    <Compile Include="NativeApi.fs" />
    <Compile Include="Assets.fs" />
    <Compile Include="ComponentLifetime.fs" />
    <Compile Include="Entity.fs" />
    <Compile Include="NativeReflectionExtensions.fs" />
    <Compile Include="Simulation.fs" />
    <Compile Include="Audio.fs" />
    <Compile Include="Sound.fs" />
    <Compile Include="Input.fs" />
    <Compile Include="ContactStream.fs" />
    <Compile Include="PhysicsComponents.fs" />
    <Compile Include="Camera.fs" />
    <Compile Include="Light.fs" />
    <Compile Include="ExtraComponents.fs" />
    <Compile Include="BehaviorTreeComponent.fs" />
    <Compile Include="BoneComponent.fs" />
    <Compile Include="DecalComponent.fs" />
    <Compile Include="FoliageComponent.fs" />
    <Compile Include="PlayerInputComponent.fs" />
    <Compile Include="SceneRenderProfileComponent.fs" />
    <Compile Include="SpriteRenderer.fs" />
    <Compile Include="SpriteSheetComponent.fs" />
    <Compile Include="StateMachineComponent.fs" />
    <Compile Include="TerrainComponent.fs" />
    <Compile Include="ExtraBindings.fs" />
    <Compile Include="Animator.fs" />
    <Compile Include="RectTransformComponent.fs" />
    <Compile Include="UIComponent.fs" />
    <Compile Include="UINavigation.fs" />
    <Compile Include="ImageComponent.fs" />
    <Compile Include="UIButton.fs" />
    <Compile Include="TextComponent.fs" />
    <Compile Include="Canvas.fs" />
    <Compile Include="UIBindings.fs" />
    <Compile Include="MeshRenderer.fs" />
    <Compile Include="Prefab.fs" />
    <Compile Include="BlackBoard.fs" />
    <Compile Include="BehaviorContracts.fs" />
    <Compile Include="RuntimeContracts.fs" />
    <Compile Include="Contacts.fs" />
    <Compile Include="Physics.fs" />
    <Compile Include="AuxiliaryFactories.fs" />
    <Compile Include="Trees.fs" />
    <Compile Include="AuxiliaryRuntime.fs" />
    <Compile Include="NativeBT.fs" />
    <Compile Include="Continuations.fs" />
    <Compile Include="Registry.fs" />
    <Compile Include="Loader.fs" />
    <Compile Include="InvokeOutcome.fs" />
    <Compile Include="Callable.fs" />
    <Compile Include="GcControl.fs" />
    <Compile Include="RuntimeBootstrap.fs" />
  </ItemGroup>
  <Target Name="WriteScriptNativeGeneratorOptions" BeforeTargets="GenerateScriptNativeBindings">
    <MakeDir Directories="$(ScriptNativeOutput)" />
    <WriteLinesToFile File="$(ScriptNativeOutput)/generator-options.txt" Lines="$(ScriptNativeGenerator);$(ScriptNativeClangArguments)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
  <Target Name="GenerateScriptNativeBindings" BeforeTargets="CoreCompile" Inputs="@(_ScriptNativeInput)" Outputs="$(ScriptNativeOutput)/reflgen_creator_script_native.fs;$(ScriptNativeOutput)/reflgen_creator_script_native.cpp;$(ScriptNativeOutput)/reflgen_creator_script_native.json">
    <Error Condition="!Exists('$(ScriptNativeGenerator)')" Text="reflgen not found: $(ScriptNativeGenerator). Install the engine vcpkg manifest or set ScriptNativeGenerator." />
    <MakeDir Directories="$(ScriptNativeOutput)" />
    <Exec Command="&quot;$(ScriptNativeGenerator)&quot; --module creator_script --output &quot;$(ScriptNativeOutput)&quot; --fsharp-table --fsharp-namespace CreatorEngine.Native &quot;$(ScriptNativeHeader)&quot; -- $(ScriptNativeClangArguments)" />
  </Target>
</Project>
