  <ItemGroup>
    <!--
      ★ **구성 조건부 참조가 Shipping 격리의 전부다**(§12.1).

        `#ifdef` 로 본문만 비우면 lib 은 여전히 링크되고, 소켓 심볼도 그대로 들어온다.
        참조 자체를 빼야 링크 단계에서 0 이 보장된다. 그래서 이 한 줄이
        `verify-player-shipping-isolation.ps1` 이 검사하는 성질의 원천이다.
    -->
    <ProjectReference Include="..\Engine\CommandService\CommandService.vcxproj"
                      Condition="'$(EngineShipping)' != 'true'">
