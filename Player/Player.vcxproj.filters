<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <ClCompile Include="PlayerApp.cpp" />
    <ClCompile Include="PlayerMain.cpp" />
    <ClCompile Include="PlayerDX12Presentation.cpp" />
    <ClCompile Include="PlayerTemporalDX12.cpp" />
    <ClCompile Include="PlayerVulkanPresentation.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="PlayerApp.h" />
    <ClInclude Include="PlayerMain.h" />
    <ClInclude Include="PlayerPresentation.h" />
    <ClInclude Include="PlayerTemporalDX12.h" />
    <ClInclude Include="PlayerDdolProbe.h" />
  </ItemGroup>
  <ItemGroup>
    <!-- Poison headers are not ClInclude inputs: reflgen must not parse them. -->
    <None Include="ForbiddenIncludes\imgui.h" />
    <None Include="ForbiddenIncludes\imgui_internal.h" />
    <None Include="PlayerBoundary.targets" />
  </ItemGroup>
</Project>
