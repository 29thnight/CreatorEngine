### VisualStudio Patch ###
# Additional files built by Visual Studio

# End of https://www.toptal.com/developers/gitignore/api/windows,visualstudio,c++
/imgui.ini
EngineVersion.h
*.creator
*.meta
/TestScene.yml
/NodeEditor/
/Dynamic_CPP/Assets/ColorGrading/
/Dynamic_CPP/Assets/Font/
/Dynamic_CPP/Assets/HDR/
# 게임 콘텐츠는 저장소에 두지 않는다. 다만 기능 테스트 자산은 예외다 —
# dx12.scene 같은 자가 검증은 '메시가 있는 씬'을 전제로 하는데, 자산이
# 전부 무시되면 이 기계 밖에서는 그 검사를 돌릴 방법이 없다.
#
# 예외는 셋 다 이름으로 좁혀 두었다(FT_ · Prim_ · *_Mat_BaseColor).
# 게임 콘텐츠가 늘어도 여기 딸려 오지 않는다. 폐포 63파일 · 2.0MB.
/Dynamic_CPP/Assets/Materials/*
!/Dynamic_CPP/Assets/Materials/*_Mat_BaseColor.png
!/Dynamic_CPP/Assets/Materials/*_Mat_BaseColor.png.meta
/Dynamic_CPP/Assets/Models/*
!/Dynamic_CPP/Assets/Models/Prim_*.glb
!/Dynamic_CPP/Assets/Models/Prim_*.glb.meta
/Dynamic_CPP/Assets/Scenes/*
!/Dynamic_CPP/Assets/Scenes/FT_*.creator
/Dynamic_CPP/Assets/Terrain/
/Dynamic_CPP/Assets/Textures/
/Dynamic_CPP/Assets/UI/
/Dynamic_CPP/Assets/VolumeticFog/
/Dynamic_CPP/Assets/imgui.ini
*.ini
GEMINI.md
gemini_worker/
/RenderEngine/DataSystem.cpp
/Dependency(추후 vcpkg 종속 제거용)/x64-windows
/Dynamic_CPP/Dynamic_CPP.vcxproj.filters.bak
/Dynamic_CPP/Assets/Materials.zip

# 기능별 테스트 스크린샷 — 실행할 때마다 다시 만들어진다(Tools/featuretest/README.md).
/Tools/featuretest/screenshots/

# 자가 검증이 남기는 산출물 (PHASE 9-9 정리)
#
# 실행할 때마다 새로 만들어지는 것이라 추적 대상이 아니다.
#
# ★ 예전에는 파일명을 하나씩 적었다. 그러면 검증이 하나 늘 때마다 여기도
#   같이 늘려야 하고, 잊으면 산출물이 조용히 커밋에 섞인다 — SSGI 비교
#   스크린샷 6장이 실제로 그렇게 들어왔다. 접두사로 묶어 그 실수를 없앤다.
#   (확장자 없는 .cache는 위 VisualStudio 절의 *.[Cc]ache가 이미 잡는다.)
dx12_*.png
vk_*.png
dx12_*.cache.*
lifecycle_trace.tsv
shutdown_trace.txt

# vcpkg 매니페스트 모드가 만드는 저장소별 설치 트리 (PHASE 4-6)
vcpkg_installed/

# Restore-VcpkgPorts.ps1이 실행마다 새로 만드는 응답 파일과 설치 로그.
# 한때 추적됐다가 정리했다 — vcpkg.json이 원본이고 이 둘은 파생물이다.
vcpkg-response.txt
vcpkg-install-log.txt

# 회귀 게이트가 매 실행마다 CLI로 다시 만드는 픽스처 — instanceID가 매번 달라져
# 추적하면 트리가 상시 더러워진다(SceneGraphRedesignPlan 트랙 P · P-write S1).
Dynamic_CPP/Assets/Prefabs/OvWriteProbe.prefab
