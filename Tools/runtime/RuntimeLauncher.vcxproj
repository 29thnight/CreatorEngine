<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{7F95EC54-7179-45EC-B685-A56C7F059846}</ProjectGuid>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <UseDebugLibraries>false</UseDebugLibraries>
    <CharacterSet>Unicode</CharacterSet>
    <VcpkgEnabled>false</VcpkgEnabled>
    <VcpkgEnableManifest>false</VcpkgEnableManifest>
    <VcpkgApplocalDeps>false</VcpkgApplocalDeps>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <TargetName>$(LauncherName)</TargetName>
    <OutDir>$(LauncherOutputDir)</OutDir>
    <IntDir>$(SolutionDir)Build\Obj\RuntimeLauncher\$(Platform)-$(EngineConfigKey)\$(LauncherName)\</IntDir>
    <LinkIncremental>false</LinkIncremental>
    <!-- The independent static-CRT launcher needs its own matching std module. -->
    <BuildStlModules>true</BuildStlModules>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp23</LanguageStandard>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <WarningLevel>Level4</WarningLevel>
      <ExceptionHandling>Sync</ExceptionHandling>
      <Optimization>MaxSpeed</Optimization>
    </ClCompile>
    <Link>
      <SubSystem>$(LauncherSubsystem)</SubSystem>
      <AdditionalDependencies>Shell32.lib;User32.lib;Dbghelp.lib;Comctl32.lib;Comdlg32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
    <Manifest>
      <AdditionalManifestFiles>$(MSBuildThisFileDirectory)RuntimeLauncher.manifest;%(AdditionalManifestFiles)</AdditionalManifestFiles>
    </Manifest>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(LauncherName)' == 'CreatorEditor'">
    <Manifest>
      <AdditionalManifestFiles>$(MSBuildThisFileDirectory)..\..\Editor\Resources\Windows\CreatorEditor.manifest;%(AdditionalManifestFiles)</AdditionalManifestFiles>
    </Manifest>
  </ItemDefinitionGroup>
  <ItemGroup><ClCompile Include="RuntimeLauncher.cpp" /><ClCompile Include="CrashReporter.cpp" /></ItemGroup>
  <ItemGroup>
    <ClCompile Include="..\..\Engine\Platform\WindowsSDK\Creator.WinAPI.h">
      <CompileAs>CompileAsHeaderUnit</CompileAs>
      <IncludeInUnityFile>false</IncludeInUnityFile>
      <AdditionalOptions>/I&quot;$(SolutionDir)Tools\build\StdModuleHeaders&quot; %(AdditionalOptions)</AdditionalOptions>
      <DisableSpecificWarnings>5260;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
  </ItemGroup>
  <ItemGroup><ClCompile Include="..\..\Engine\Contracts\Platform\Windows\Creator.Platform.Windows.Strings.ixx"><CompileAs>CompileAsCppModule</CompileAs><IncludeInUnityFile>false</IncludeInUnityFile></ClCompile></ItemGroup>
  <!-- Compile the canonical ABI constants with this independent static-CRT launcher. -->
  <ItemGroup><ClCompile Include="..\..\Engine\Contracts\Core\Creator.Core.ContentAbi.ixx"><CompileAs>CompileAsCppModule</CompileAs><IncludeInUnityFile>false</IncludeInUnityFile></ClCompile></ItemGroup>
  <ItemGroup><ClCompile Include="..\..\Engine\Contracts\Core\Creator.Core.Distribution.ixx"><CompileAs>CompileAsCppModule</CompileAs><IncludeInUnityFile>false</IncludeInUnityFile></ClCompile></ItemGroup>
  <ItemGroup><ClCompile Include="..\..\Engine\Containers\Creator.Containers.h"><CompileAs>CompileAsHeaderUnit</CompileAs><IncludeInUnityFile>false</IncludeInUnityFile></ClCompile></ItemGroup>
  <ItemGroup><ResourceCompile Include="EngineVersion.rc" /></ItemGroup>
  <ItemGroup Condition="'$(LauncherName)' == 'CreatorEditor'">
    <ResourceCompile Include="..\..\Editor\Resources\Windows\Academy_4Q.rc" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
