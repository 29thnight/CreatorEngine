schemaVersion: 1
mapName: "PlayerKeyBoard"
actions:
  - actionName: "Move"
    inputType: "KeyBoard"
    actionType: "Value"
    keyState: "Down"
    keys: [37, 39, 40, 38]
    scriptName: "Player"
    functionName: "Move"
  - actionName: "StartAttack"
    inputType: "KeyBoard"
    actionType: "Button"
    keyState: "Down"
    keys: [74, 65, 65, 65]
    scriptName: "Player"
    functionName: "StartAttack"
  - actionName: "AttackCharging"
    inputType: "KeyBoard"
    actionType: "Button"
    keyState: "Pressed"
    keys: [74, 65, 65, 65]
    scriptName: "Player"
    functionName: "Charging"
  - actionName: "Attack"
    inputType: "KeyBoard"
    actionType: "Button"
    keyState: "Released"
    keys: [74, 65, 65, 65]
    scriptName: "Player"
    functionName: "ChargeAttack"
  - actionName: "Dash"
    inputType: "KeyBoard"
    actionType: "Button"
    keyState: "Down"
    keys: [32, 65, 65, 65]
    scriptName: "Player"
    functionName: "Dash"
  - actionName: "CatchAndThrow"
    inputType: "KeyBoard"
    actionType: "Button"
    keyState: "Down"
    keys: [75, 65, 65, 65]
    scriptName: "Player"
    functionName: "CatchAndThrow"
  - actionName: "SwapWeaponLeft"
    inputType: "KeyBoard"
    actionType: "Button"
    keyState: "Released"
    keys: [90, 65, 65, 65]
    scriptName: "Player"
    functionName: "SwapWeaponLeft"
  - actionName: "SwapWeaponRight"
    inputType: "KeyBoard"
    actionType: "Button"
    keyState: "Released"
    keys: [88, 65, 65, 65]
    scriptName: "Player"
    functionName: "SwapWeaponRight"
