<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="CreatorEngine">
  <Profiles>
    <SystemCollector Id="GeometryCollector" Name="NT Kernel Logger">
      <BufferSize Value="1024" />
      <Buffers Value="512" />
    </SystemCollector>
    <SystemProvider Id="GeometryKernel">
      <Keywords>
        <Keyword Value="ProcessThread" />
        <Keyword Value="Loader" />
        <Keyword Value="CSwitch" />
        <Keyword Value="ReadyThread" />
        <Keyword Value="SampledProfile" />
      </Keywords>
      <Stacks>
        <Stack Value="SampledProfile" />
      </Stacks>
    </SystemProvider>
    <Profile Id="Geometry.Verbose.File" Name="Geometry" Description="SceneHost CPU samples and scheduler states"
             LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="GeometryCollector">
          <SystemProviderId Value="GeometryKernel" />
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
