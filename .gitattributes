###############################################################################
# Set default behavior to automatically normalize line endings.
###############################################################################
* text=auto

###############################################################################
# 저작 자산의 개행 — LF 고정 (SerializationPlan D3-b)
#
# 위의 `* text=auto`는 **커밋할 때만** 정규화한다. 체크아웃은 core.autocrlf에
# 맡기므로 Windows 작업 트리가 CRLF가 되고, 엔진이 다시 쓰면 CRLF로 남는다.
# 그 결과가 "git status는 더러운데 git diff는 비어 있다"였다 — index는 이미
# LF인데 작업 트리 바이트만 다르기 때문이다.
#
# `eol=lf`는 **작업 트리까지** LF로 고정해 그 왕복을 없앤다. 이유 셋:
#   1. git index는 이미 LF다. 이 규칙은 저장소를 바꾸는 것이 아니라 작업 트리를
#      저장소와 일치시킨다.
#   2. content-addressed VCS(예: Lore)에는 `text=auto` 같은 정규화 계층이 없다.
#      거기서는 CRLF와 LF가 곧 다른 콘텐츠이므로, 플랫폼 중립인 LF가 안전하다.
#   3. ryml은 CRLF를 만나면 파싱 실패가 아니라 프로세스를 abort한다. LF로 통일하면
#      파싱 전 정규화 사본이 불필요해진다.
#
# 게이트: Tools/regression/verify-authoring-line-endings.ps1
###############################################################################
*.creator    text eol=lf
*.prefab     text eol=lf
*.meta       text eol=lf
*.shadermeta text eol=lf
*.volume     text eol=lf
*.bt         text eol=lf
*.blackboard text eol=lf
*.hlsl       text eol=lf
*.hlsli      text eol=lf

###############################################################################
# ★ `.asset` 확장자 하나가 두 포맷을 담는다.
#
#   · Assets/Materials/**.asset — 평문 YAML
#   · Assets/Models/**.asset    — `CEMA` 매직으로 시작하는 바이너리 모델 캐시
#
# `* text=auto`는 내용을 보고 추측한다. 지금은 모델 쪽에 널 바이트가 많아 우연히
# binary로 판정되지만, 추측에 기대는 상태다. 텍스트로 오판되면 개행 정규화가
# 바이너리를 깨뜨린다 — 명시로 못 박는다.
###############################################################################
Dynamic_CPP/Assets/Models/**/*.asset     binary
Dynamic_CPP/Assets/Materials/**/*.asset  text eol=lf
# ★ 저작 자산은 `Assets/` 안에만 있지 않다. 프로젝트 설정 3개도 평문 YAML이고
#   에디터가 저장한다 — 이 규칙이 없어 `* text=auto`가 적용되고, `core.autocrlf=true`와
#   맞물려 **체크아웃마다 CRLF로 되돌아갔다**(D3-b-1 후속으로 발견).
Dynamic_CPP/ProjectSetting/*.asset       text eol=lf


###############################################################################
# Set default behavior for command prompt diff.
#
# This is need for earlier builds of msysgit that does not have it on by
# default for csharp files.
# Note: This is only used by command line
###############################################################################
#*.cs     diff=csharp

###############################################################################
# Set the merge driver for project and solution files
#
# Merging from the command prompt will add diff markers to the files if there
# are conflicts (Merging from VS is not affected by the settings below, in VS
# the diff markers are never inserted). Diff markers may cause the following 
# file extensions to fail to load in VS. An alternative would be to treat
# these files as binary and thus will always conflict and require user
# intervention with every merge. To do so, just uncomment the entries below
###############################################################################
#*.sln       merge=binary
#*.csproj    merge=binary
#*.vbproj    merge=binary
#*.vcxproj   merge=binary
#*.vcproj    merge=binary
#*.dbproj    merge=binary
#*.fsproj    merge=binary
#*.lsproj    merge=binary
#*.wixproj   merge=binary
#*.modelproj merge=binary
#*.sqlproj   merge=binary
#*.wwaproj   merge=binary

###############################################################################
# behavior for image files
