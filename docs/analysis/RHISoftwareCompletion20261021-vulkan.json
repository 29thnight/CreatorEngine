  "test_boundary": {
    "summary": "Compile and exercise Vulkan software recording against the official SDK ABI.\n\nThe Vulkan command pool, recording snapshot, validator, encoder, upload/descriptor\nallocators, resource/pipeline registries, common recorder/translator/FIFO and\nJobScheduler/enkiTS are the actual source. Vulkan function pointers are CPU mocks;\nthis does not run a Vulkan device or validate rendered pixels. A mirrored header\nexcludes unrelated texture-cache declarations/COM and trailing mesh declarations.\nOne pre-existing GCC aggregate assignment is spelled with its explicit type in\nthat mirror. Windows handle/environment/debug calls and the Win32 profiler's\nthread-name registration are mock boundaries. Device Initialize/Shutdown and\nadmission/submit bodies are exact; physical-device creation, WSI, prefix flush,\nmemory-budget refresh and lifecycle-idle proof are mocks. Completion advances\nonly when the fixture explicitly advances its fake fence. The mimalloc boundary\nuses libc allocation; the warm snapshot counter observes standard operator new.\nProduction is never edited, and neither renderer execution nor pixels are tested.",
    "mirror_adaptations": {
      "Engine/RenderEngine/RHI/Vulkan/VulkanDeviceResources.h": "Exclude unrelated trailing VulkanTextureCache and its COM-dependent header; complete device class unchanged.",
      "Engine/RenderEngine/RHI/IRenderDeviceServices.h": "Exclude trailing mesh declarations and their two Assets includes; complete service interface unchanged.",
      "Engine/EngineDiagnostics/ProfileService.h": "No-op Win32 profiler thread-name registration boundary only; CE_SHIPPING removes profile events.",
      "Engine/RenderEngine/RHI/RHIGraphicsPipelineRequest.h": "GCC compatibility spelling of pre-existing aggregate assignment; no Vulkan changed body adapted."
    },
    "platform_shims": [
      "windows.h supplies handle typedefs, 32-bit DWORD, GetEnvironmentVariableA returning zero, and OutputDebugStringA no-op.",
      "The mimalloc API boundary uses libc malloc/posix_memalign/free. Production allocator source is compiled, but this is not the Windows mimalloc implementation.",
      "Official Vulkan SDK function-pointer types are installed with fixture CPU implementations; no Vulkan loader, driver or real device is used."
    ],
    "device_mock_endpoints": [
      "CreateInstance / PickPhysicalDevice / CreateDevice / CreateFrameResources: assign fixture native identities instead of creating Vulkan objects.",
