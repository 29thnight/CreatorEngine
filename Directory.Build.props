<?xml version="1.0" encoding="utf-8"?>
<!--
  솔루션 전체에 자동으로 걸리는 속성 파일이다. MSBuild가 프로젝트 디렉터리에서
  위로 올라가며 처음 만나는 이 파일을 프로젝트보다 먼저 임포트한다 —
  vcxproj 여덟 개를 각각 고치지 않아도 되는 유일한 자리다.

  ── EngineAsan ──

  AddressSanitizer 구성을 솔루션 구성(Debug|Release)으로 늘리지 않고 스위치로 뒀다.
  구성을 늘리면 vcxproj 여덟 개 × ItemDefinitionGroup을 전부 복제해야 하고,
  그렇게 늘어난 구성은 아무도 갱신하지 않아 곧 실제 빌드와 어긋난다.

    msbuild CreatorEngine.sln /p:Configuration=Debug /p:Platform=x64 /p:EngineAsan=true

  실제 컴파일 옵션은 Directory.Build.targets가 정한다. 여기서 정하면 프로젝트가
  자기 ItemDefinitionGroup으로 덮어쓰므로(임포트 순서상 프로젝트가 뒤다) 무력화된다.
-->
<Project>
  <PropertyGroup>
    <EngineAsan Condition="'$(EngineAsan)' == ''">false</EngineAsan>

    <!--
      ── EngineShipping — Development/Shipping 구분 (PHASE 14.5 LC8) ──

      `EditorAutomationCLIPlan.md` §11.1 과 `ProfilingCapturePlan.md` §5.2 가 같은
      구분을 요구한다: Development 는 명령 서비스·프로파일러 marker 를 담고,
      Shipping 은 **링크 단계에서** 그것들을 뺀다. 두 계획이 "먼저 도착하는 쪽이
      만들고 다른 쪽이 소비한다"고 적어 두었고, LC8 이 먼저 도착했다.

        msbuild CreatorEngine.sln /p:Configuration=Release /p:Platform=x64 /p:EngineShipping=true

      ★ **솔루션 구성을 늘리지 않고 스위치로 둔다.** 위 EngineAsan 이 같은
        판단을 한 자리이고, 그 이유가 여기에도 그대로 적용된다 — 구성을 늘리면
        vcxproj 13 개 × ItemDefinitionGroup 을 복제해야 하고, 그렇게 늘어난 구성은
        아무도 갱신하지 않아 곧 실제 빌드와 어긋난다. §12.1 은 "13개 프로젝트에
        구성을 추가하는 솔루션 전역 변경"이라고 적었지만, 그 문장이 세는 비용이
        바로 이 파일이 이미 겪고 적어 둔 비용이다.

        스위치로 얻는 것은 같다: compile-out 매크로(아래 targets), 구성 조건부
        `ProjectReference`(Player.vcxproj), 그리고 구분되는 산출물(아래 키).
        잃는 것은 IDE 구성 드롭다운에서 고를 수 없다는 것 하나다.

      ★★ **산출물 키를 가른다.** ASan 은 진단 빌드라 같은 자리에 덮어써도
        됐지만, Shipping 은 **Development 와 나란히 존재해야** 한다 — 격리 게이트가
        "Shipping 바이너리에 서비스 심볼 0" 을 보려면 두 바이너리를 같은 실행에서
        견줘야 하고, 한 자리를 공유하면 방금 덮어쓴 쪽만 보게 된다.

          Bin\x64-Release\Player\            Development
          Bin\x64-Release-Shipping\Player\   Shipping

      ★★★ **Editor 에는 Shipping 개념이 없다**(§12.1). 이 스위치를 켜고 솔루션을
        통째로 빌드하면 Editor 도 그 키로 나오지만 그 산출물은 쓰지 않는다 —
        `Tools/build.ps1` 은 Player 패키지를 만들 때만 이 스위치를 켠다.
    -->
    <EngineShipping Condition="'$(EngineShipping)' == ''">false</EngineShipping>
    <EngineConfigKey>$(Configuration)</EngineConfigKey>
    <EngineConfigKey Condition="'$(EngineShipping)' == 'true'">$(Configuration)-Shipping</EngineConfigKey>
    <!--
      Release LTCG의 .ipdb/.iobj는 host linker의 증분 상태다. 같은 x64 target을
      Bin\MSBuild.exe(x86 host)와 Bin\amd64\MSBuild.exe(x64 host)로 번갈아
      빌드하면 같은 IntDir에 서로 다른 host 상태가 섞여 다음 링크가 대규모
      LTCG 재생성으로 후퇴한다. target Platform과 별개로 host tool도 x64로
      고정해 IDE, 직접 MSBuild, build.ps1, CI가 같은 캐시 계약을 사용하게 한다.
    -->
    <PreferredToolArchitecture Condition="'$(Platform)' == 'x64'">x64</PreferredToolArchitecture>
    <!--
      $(SolutionDir)는 .sln 경유 빌드에서만 정의된다. vcxproj를 단독 빌드하면
      미정의라 "$(SolutionDir)EngineOutput.props" 임포트부터 무너져, 지금까지
      단독 프로젝트 빌드가 불가능했다. 두 .sln 모두 이 파일과 같은 폴더에
      있으므로 여기가 곧 솔루션 디렉터리다 — 미정의일 때만 채운다.
      (MSBuildThisFileDirectory는 후행 백슬래시를 포함해 관례와 같다)
    -->
    <SolutionDir Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)</SolutionDir>

    <!--
      ── vcpkg 매니페스트 모드 (PHASE 4-6) ──

      켜지 않으면 vcpkg.json은 아무 일도 하지 않는다. vcpkg의 MSBuild 통합은
      매니페스트를 기본으로 쓰지 않고, 파일만 있으면 "켜시겠습니까" 안내만
      낸다(vcpkg.targets 130행).

      켜면 의존 해석이 사용자 전역 설치(vcpkg\installed\)에서 저장소 안의
      vcpkg_installed\로 옮겨진다. 무엇이 어느 판본으로 들어오는지가
      vcpkg.json + builtin-baseline 두 줄로 고정되므로, 새 환경에서
      "내 기계에선 되는데"가 나올 자리가 사라진다.

      대가: 저장소별 설치 트리 1.5GB(.gitignore에 있다). 시간은 vcpkg의
      바이너리 캐시가 있느냐로 갈린다 — 캐시가 빈 첫 환경은 소스에서 빌드해
      오래 걸리고(실측 38분), 캐시가 차 있으면 통째로 지웠다 다시 받아도
      26초다(실측). 즉 반복 비용이 아니라 환경당 1회 비용이다.
    -->
    <VcpkgEnableManifest>true</VcpkgEnableManifest>

    <!--
      ── 산출물 디렉터리 규약 (E7, 2026-08-24) ──

      중간물(obj·유니티 스텁·컴파일러 pdb)과 정적 lib를 Build\ 아래로 격리한다.
      전에는 IntDir이 전 프로젝트 미지정이라 각 프로젝트 폴더 밑 x64\에 18곳으로
      흩어졌고(소스 검색이 매번 x64\를 걸러야 했다), Release lib 12개가 exe와
      함께 Bin\Editor\에 뒤섞였다.

        Build\Obj\<프로젝트>\<플랫폼>-<구성>\   중간물
        Build\Lib\<플랫폼>-<구성>\              정적 라이브러리
        Bin\<플랫폼>-<구성>\Editor\              Editor 실행 번들
        Bin\<플랫폼>-<구성>\Player\              Player 실행 번들
        Bin\<플랫폼>-<구성>\Tools\<도구>\        도구 실행 번들
        Bin\<플랫폼>-<구성>\Managed\             공통 관리 어셈블리

      실행 산출물은 EngineOutput.props가 역할별 경로를 정한다. exe 프로젝트는
      자기 vcxproj의 OutDir 명시가 이 정적 lib 기본값을 덮는다.
      .vcxproj 한정 조건인 이유: 이 파일은 C# 프로젝트(GameScripts·ScriptCore)
      에도 걸리는데 OutDir은 C# 출력도 바꿔 버린다.
    -->
    <!--
      $(MSBuildProjectName)이어야 한다 — $(ProjectName)은 Microsoft.Cpp.Default.props
      가 채우는데 이 파일이 그보다 먼저 평가되므로 빈 문자열이 박혀, 전 프로젝트의
      obj가 Build\Obj\<플랫폼-구성>\ 한 솥에 섞인다(동명 cpp가 서로 덮어쓴다).
    -->
    <!--
      $(EngineConfigKey)는 $(Configuration) 이거나 그 뒤에 -Shipping 이 붙은 값이다
      (위 EngineShipping 참고). 중간물과 정적 lib 도 그 키로 갈라야 한다 — 같은
      IntDir 을 공유하면 Shipping 빌드가 Development 의 .obj 를 재사용해 "심볼 0"
      게이트가 방금 지운 코드를 다시 링크하고도 초록으로 남는다.
    -->
    <IntDir Condition="'$(MSBuildProjectExtension)' == '.vcxproj'">$(SolutionDir)Build\Obj\$(MSBuildProjectName)\$(Platform)-$(EngineConfigKey)\</IntDir>
    <OutDir Condition="'$(MSBuildProjectExtension)' == '.vcxproj'">$(SolutionDir)Build\Lib\$(Platform)-$(EngineConfigKey)\</OutDir>

    <!--
      SDK-style C# 프로젝트도 기본 obj\를 소스 폴더에 만들지 않는다. Base 경로만
      공용으로 옮기고 Configuration/TargetFramework 구분은 SDK 기본 규약에 맡긴다.
      ScriptCore와 GameScripts의 최종 어셈블리는 각 csproj가 Bin\...\Managed를,
      컴파일 타임 전용 소스 제너레이터는 Build\Tools\Managed를 사용한다.
    -->
    <BaseIntermediateOutputPath Condition="'$(MSBuildProjectExtension)' == '.csproj'">$(MSBuildThisFileDirectory)Build\Obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>

    <!--
      ── 디버그 이터레이터 검사(_ITERATOR_DEBUG_LEVEL=0) 시도와 좌초 ──
         (ContainerLibraryDesign §5 C0-2, 2026-08-17)

      배선은 여기 두 줄이면 끝난다:
        <VcpkgTriplet>x64-windows-idl0</VcpkgTriplet>
        + Debug 구성에 _ITERATOR_DEBUG_LEVEL=0 전처리기 정의

      그런데 **physx가 막는다.** 이 매크로는 링크 단위 ABI라 프로세스 안의 모든
      목적 파일이 값을 맞춰야 하는데, physx의 vcpkg 포트는 자체 CMake가
      CMAKE_CXX_FLAGS_DEBUG를 덮어써서 트리플릿의 VCPKG_CXX_FLAGS_DEBUG를
      무시한다. 실측으로 확인했다 — x64-windows-idl0 트리로 다시 빌드한
      PhysXExtensions_static_64.lib(debug)에도 여전히
      /FAILIFMISMATCH:_ITERATOR_DEBUG_LEVEL=2가 박혀 있다.

      뚫으려면 physx 포트 오버레이를 만들어 빌드 스크립트를 패치해야 하고,
      그것은 physx 5.5.0에 고정된 영구 유지보수 항목이 된다. 그 값어치는 별도
      결정으로 남긴다 — 트리플릿 둘(triplets/)은 그대로 두었으므로 patch만
      더하면 이어서 할 수 있다.

      측정 목적만 놓고 보면 더 싼 길이 있다: 할당 귀속에서 _Container_proxy를
      따로 분류해 빼면 된다(mem.hook top이 그렇게 한다). 성능 이득은 못 얻지만
      "실제 코드의 할당량"은 그것으로 읽을 수 있다.
    -->
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <!--
        솔루션의 모든 C++ 구성(Debug/Release, Win32/x64)이 같은 언어 표준을 쓴다.
        각 vcxproj의 기존 x64 명시값도 stdcpp23으로 맞춰 IDE 속성 페이지와
        공용 기본값이 어긋나지 않게 한다. VS 18/v145에서 stdcpp23은
        /std:c++23preview로 매핑된다.
      -->
      <LanguageStandard>stdcpp23</LanguageStandard>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
