<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)..\EngineOutput.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- 클래스 라이브러리는 기본적으로 runtimeconfig.json을 만들지 않는다.
         호스트(hostfxr)가 런타임 버전을 결정할 때 이 파일이 반드시 필요하다. -->
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>

    <!-- Editor와 Player가 같은 구성별 Managed 루트를 명시적으로 참조한다. -->
    <OutputPath>$(EngineManagedOutDir)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- 06절 AOT 대응: 지금부터 트리밍 경고를 보이게 해두면 나중에 몰아서 고칠 일이 없다. -->
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <!-- 소스 제너레이터로 참조한다(런타임 의존성이 아니라 컴파일 타임 도구).
         [SerializeField] 접근자와 ScriptFactory 등록 코드를 여기서 만들어 낸다. -->
    <ProjectReference Include="..\ScriptCore.Generators\ScriptCore.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- SDK MSBuild cannot evaluate C++ projects. The launcher uses VS x64 MSBuild,
       asking only for generation, never Build/ClCompile or project references. -->
  <Target Name="GenerateEngineScriptBindings"
          BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <!-- Do not end a quoted Windows native argument with a backslash. -->
      <_EngineScriptBindingsVcpkgDirectory Condition="'$(VcpkgInstalledDir)' != ''">$([MSBuild]::EnsureTrailingSlash('$(VcpkgInstalledDir)')).</_EngineScriptBindingsVcpkgDirectory>
      <_EngineScriptBindingsReflgenDirectory Condition="'$(ReflgenOutputDirectory)' != ''">$([MSBuild]::EnsureTrailingSlash('$(ReflgenOutputDirectory)')).</_EngineScriptBindingsReflgenDirectory>
    </PropertyGroup>
    <Exec Command="&quot;$(EngineScriptBindingsPowerShell)&quot; -NoProfile -File &quot;$(MSBuildThisFileDirectory)..\Tools\ScriptBindings\Invoke-ScriptBindingGeneration.ps1&quot; -Configuration &quot;$(Configuration)&quot; -Platform &quot;$(EnginePlatform)&quot; -EngineShipping &quot;$(EngineShipping)&quot; -EngineAsan &quot;$(EngineAsan)&quot; -OutputDirectory &quot;$(EngineScriptBindingsOutputDirectory).&quot; -MSBuild &quot;$(EngineScriptBindingsMSBuild)&quot; -ReflgenTargets &quot;$(EngineReflgenTargets)&quot; -ReflgenExecutable &quot;$(ReflgenExecutable)&quot; -ReflgenOutputDirectory &quot;$(_EngineScriptBindingsReflgenDirectory)&quot; -PowerShellExecutable &quot;$(EngineScriptBindingsPowerShell)&quot; -VcpkgInstalledDirectory &quot;$(_EngineScriptBindingsVcpkgDirectory)&quot; -VcpkgTriplet &quot;$(VcpkgTriplet)&quot;"
          StdOutEncoding="utf-8" StdErrEncoding="utf-8"
          Condition="'$(DesignTimeBuild)' != 'true'" />
    <ItemGroup>
      <Compile Include="$(EngineScriptBindingsOutputDirectory)ScriptLightApi.g.cs"
               Condition="'$(DesignTimeBuild)' != 'true' or Exists('$(EngineScriptBindingsOutputDirectory)ScriptLightApi.g.cs')" />
      <Compile Include="$(EngineScriptBindingsOutputDirectory)Native.Light.g.cs"
               Condition="'$(DesignTimeBuild)' != 'true' or Exists('$(EngineScriptBindingsOutputDirectory)Native.Light.g.cs')" />
      <Compile Include="$(EngineScriptBindingsOutputDirectory)LightComponent.g.cs"
               Condition="'$(DesignTimeBuild)' != 'true' or Exists('$(EngineScriptBindingsOutputDirectory)LightComponent.g.cs')" />
    </ItemGroup>
  </Target>

</Project>
