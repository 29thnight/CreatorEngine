file(READ "${CMAKE_CURRENT_LIST_DIR}/manifest.json" manifest)
string(JSON count LENGTH "${manifest}")
math(EXPR last "${count}-1")
foreach(index RANGE ${last})
 string(JSON header GET "${manifest}" ${index} header)
 string(REPLACE ".h" ".ixx" unit "${header}")
 file(READ "${CMAKE_CURRENT_LIST_DIR}/${unit}" source)
 string(REPLACE "\r\n" "\n" source "${source}")
 set(start_marker "// CE_MODULE_BODY_BEGIN\nexport {\n")
 set(end_marker "} // export\n// CE_MODULE_BODY_END")
 string(FIND "${source}" "${start_marker}" begin)
 string(FIND "${source}" "${end_marker}" end)
 if(begin LESS 0 OR end LESS 0)
  message(FATAL_ERROR "Invalid canonical module body: ${unit}")
 endif()
 string(LENGTH "${start_marker}" skip)
 math(EXPR begin "${begin}+${skip}")
 math(EXPR length "${end}-${begin}")
 string(SUBSTRING "${source}" ${begin} ${length} body)
 string(REPLACE "// CE_HEADER_INCLUDE #include" "#include" body "${body}")
 file(READ "${CMAKE_CURRENT_LIST_DIR}/../include/ce/${header}" actual)
 string(REPLACE "\r\n" "\n" actual "${actual}")
 if(NOT actual STREQUAL "#pragma once\n${body}")
  message(FATAL_ERROR "Generated header stale: ${header}. Run modules/sync-headers.ps1")
 endif()
endforeach()
message(STATUS "Canonical module/header bodies match: ${count}")
