+bool TaskScheduler::BeginIdleSpin( uint32_t threadNum_ ) noexcept
+{
+    ThreadDataStore& thread = m_pThreadDataStore[threadNum_];
+    if( !thread.idleSpinEligible )
+    {
+        return false;
+    }
+    // sleep의 즉시 반환/허위 깨움으로 동일 유휴 구간의 예산을 다시 받지 않습니다.
+    thread.idleSpinEligible = false;
+    const IdleSpinCallbacks& callbacks = m_Config.idleSpinCallbacks;
+    if( GetIsShutdownRequested() || callbacks.begin == nullptr || callbacks.poll == nullptr
+        || callbacks.end == nullptr )
+    {
+        return false;
+    }
+    thread.idleSpinActive = callbacks.begin( callbacks.userData, threadNum_ );
+    return thread.idleSpinActive;
+}
+
+bool TaskScheduler::PollIdleSpin( uint32_t threadNum_ ) noexcept
+{
+    if( GetIsShutdownRequested() )
+    {
+        EndIdleSpin( threadNum_, IdleSpinResult::Shutdown );
+        return false;
+    }
+    const IdleSpinCallbacks& callbacks = m_Config.idleSpinCallbacks;
+    const IdleSpinDecision decision = callbacks.poll( callbacks.userData, threadNum_ );
+    if( decision == IdleSpinDecision::Continue )
+    {
+        return true;
+    }
+    EndIdleSpin( threadNum_, decision == IdleSpinDecision::BudgetExhausted
+        ? IdleSpinResult::BudgetExhausted : (decision == IdleSpinDecision::Shutdown
+            ? IdleSpinResult::Shutdown : IdleSpinResult::ScopeEnded) );
+    return false;
+}
+
+void TaskScheduler::EndIdleSpin( uint32_t threadNum_, IdleSpinResult result_ ) noexcept
+{
+    ThreadDataStore& thread = m_pThreadDataStore[threadNum_];
+    if( result_ == IdleSpinResult::TaskFound )
+    {
+        thread.idleSpinEligible = true;
+        thread.idleSpinTaskExecuted = true;
+    }
+    if( !thread.idleSpinActive )
+    {
+        return;
+    }
+    // callback이나 새 작업이 오래 실행돼도 spin 시간/동시 허가에 포함되지 않습니다.
+    thread.idleSpinActive = false;
+    const IdleSpinCallbacks& callbacks = m_Config.idleSpinCallbacks;
+    callbacks.end( callbacks.userData, threadNum_, result_ );
+}
